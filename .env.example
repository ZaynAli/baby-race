# Supabase → Project Settings → API
# Use the project URL and the anon / publishable key only.
# Never put the service-role key or the host password in this file.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional. QR codes use this address when set (no trailing slash).
# On Vercel, set it to the production URL so a preview deploy still
# sends guests to the live site. Leave blank to use the current browser URL.
VITE_PUBLIC_URL=https://your-baby-race.vercel.app
